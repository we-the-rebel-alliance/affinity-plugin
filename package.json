{
  "name": "@we-the-rebel-alliance/affinity-plugin",
  "version": "0.0.0",
  "type": "module",
  "description": "Affinity CRM for OpenCode: read the firm's companies, people, deals, lists, notes and meetings, and change them through Affinity's own MCP tools.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin-contract",
    "affinity"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/we-the-rebel-alliance/affinity-plugin.git"
  },
  "homepage": "https://github.com/we-the-rebel-alliance/affinity-plugin#readme",
  "bugs": "https://github.com/we-the-rebel-alliance/affinity-plugin/issues",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./server": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm run bundle && git diff --exit-code dist/ && npm run test && npm run conformance && npx plugin-kit docs --check && npm run test:pack",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js --external:'@opencode/*'",
    "test": "vitest run",
    "conformance": "plugin-kit check",
    "test:pack": "node test/pack/pack.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@opencode/client": "2.4.1",
    "@opencode/plugin": "2.4.1",
    "@opencode/sdk": "2.4.1",
    "@types/node": "24.19.2",
    "@we-the-rebel-alliance/plugin-contract": "github:we-the-rebel-alliance/plugin-contract#v0.0.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "capabilities": {
    "version": 1,
    "plugin": {
      "name": "affinity",
      "title": "Affinity",
      "summary": "Affinity CRM: the firm's companies, people, deals, lists, notes and meetings, read through Affinity's MCP server and its own tools. Pass account for each alias. send_feedback is offered only when the user asks. Writes reach the firm's shared CRM and share its monthly API quota.",
      "vendor": {
        "id": "affinity",
        "name": "Affinity",
        "domain": "affinity.co"
      },
      "icons": [
        {
          "src": "assets/icon.svg",
          "type": "image/svg+xml"
        },
        {
          "src": "assets/icon-128.png",
          "type": "image/png"
        },
        {
          "src": "assets/icon-256.png",
          "type": "image/png"
        }
      ],
      "host": {
        "opencode": ">=2.4.1 <2.5.0",
        "tested": [
          "2.4.1"
        ]
      }
    },
    "accounts": {
      "via": "mcp",
      "profile": {
        "$ref": "#/options/properties/accounts/additionalProperties"
      },
      "owner": "affinity"
    },
    "options": {
      "type": "object",
      "properties": {
        "access": {
          "type": "string",
          "enum": [
            "all",
            "ask-changes",
            "read-only"
          ],
          "default": "all",
          "title": "Access",
          "description": "How much the plugin's methods may do: all runs every method, ask-changes asks before a change, read-only runs reads only."
        },
        "accounts": {
          "type": "object",
          "title": "Accounts",
          "description": "One profile per account alias, such as work or personal. Each alias signs in to its own Affinity MCP server, affinity or affinity-<alias>.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "clientId": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
                "description": "Optional: the client ID of your organisation's own Public OAuth app in Affinity, a UUID. Without it, the sign-in uses OpenCode's own client metadata and the server sets no client id."
              }
            },
            "additionalProperties": false
          }
        },
        "allowUntestedHost": {
          "type": "boolean",
          "default": false,
          "title": "Allow an untested host",
          "description": "Start on an OpenCode release outside the tested range instead of refusing with HOST_UNTESTED."
        }
      },
      "additionalProperties": false
    },
